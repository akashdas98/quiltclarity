# Replace with the final public HTTPS origin before a production build.
SITE_URL=https://quiltclarity.com

# Optional until the public Search Console property supplies its token.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set true only on a staging deployment. Production must leave this false.
PUBLIC_ROBOTS_NOINDEX=false

# The registered production profile enables this in .env.production.
# Set false in the build environment to disable it; local/staging origins
# and browser privacy signals never send analytics requests.
PUBLIC_SIMPLE_ANALYTICS_ENABLED=false
