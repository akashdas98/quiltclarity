---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact QuiltClarity"
  description="Email QuiltClarity with questions about the site, privacy, or a calculation."
  pageType="article"
>
  <article class="page article-page">
    <header class="hero compact-hero">
      <p class="eyebrow">Contact</p>
      <h1>Contact QuiltClarity</h1>
      <p class="lede">
        Have a question about the site, a calculation, or your information?
        Email{' '}
        <a href="mailto:contact@quiltclarity.com">contact@quiltclarity.com</a>.
      </p>
    </header>

    <div class="article-body">
      <section>
        <h2>Help us understand your question</h2>
        <p>
          If you are asking about a result, include the tool you used, the
          inputs needed to reproduce it, and what you expected. Avoid sending
          sensitive project information unless it is needed for your request.
        </p>
        <p>
          You can also use the <a href="/corrections/">Feedback page</a> for feedback,
          read the <a href="/methodology/">calculation methodology</a>, or
          review the <a href="/privacy/">Privacy page</a> to learn how email is handled.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
