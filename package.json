{
  "name": "quiltclarity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev-host": "node scripts/dev-server.mjs --host",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:browser": "npm run build && node scripts/browser_smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format && npm test && npm run build"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "astro": "^7.1.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
